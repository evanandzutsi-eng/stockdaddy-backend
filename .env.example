# =========================================================================
# NGX INTELLIGENCE TERMINAL - ENVIRONMENT VARIABLES
# =========================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# Core Application
DEBUG=false
SECRET_KEY=change-me-to-a-random-64-character-string
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# PostgreSQL / TimescaleDB
POSTGRES_USER=ngx_admin
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=ngx_terminal

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Business Rules
DEMO_MODE_ENABLED=true
DEMO_INITIAL_BALANCE_NGN=1000000.00
MIN_TRADES_TO_POST=3

# AI Moderation (Optional)
AI_MODERATION_WEBHOOK_URL=

# Broker Affiliate Deep Links (Optional)
BROKER_AFFILIATE_BAMBOO=
BROKER_AFFILIATE_TROVE=
BROKER_AFFILIATE_CHAKA=

# Payment Gateway (Optional - for "Show Love" tipping)
PAYSTACK_SECRET_KEY=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=